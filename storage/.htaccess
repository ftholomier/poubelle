# Cache, sauvegardes du contenu et archives de déploiement. Ces dernières
# contiennent data/admin/ : une archive téléchargeable livrerait l'empreinte
# du mot de passe d'administration et le mot de passe SMTP en clair.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Deny from all
</IfModule>
