# =====================================================================
#  Animateur Pour Votre Soirée — configuration (modifiable dans le back-office)
#  Ce fichier est copié en config/.env au premier lancement, avec des secrets
#  générés automatiquement. Ne le placez jamais dans le dossier public/.
# =====================================================================

# --- Site
APP_NAME="Animateur Pour Votre Soirée"
APP_URL=https://www.animateurpourvotresoiree.com
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Chemin secret du back-office (ex. gestion-7f3k) : https://votre-site/<ADMIN_PATH>/
ADMIN_PATH=gestion
# Jeton à saisir pour créer le premier compte administrateur (vidé après usage)
SETUP_TOKEN=
CONTACT_EMAIL=contact@animateurpourvotresoiree.com
ADMIN_ALERT_EMAILS=
# Ancien site (rapatriement des photos lors de la migration)
OLD_SITE_URL=https://www.animateurpourvotresoiree.com
FORCE_HTTPS=true
# IP des proxys de confiance (ex. "cloudflare" ou 10.0.0.0/8), vide sinon
TRUSTED_PROXIES=
MAINTENANCE_MODE=false
MAINTENANCE_ALLOWED_IPS=
CRON_TOKEN=

# --- Emails (MAIL_DRIVER = smtp | mail | log)
MAIL_DRIVER=mail
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@animateurpourvotresoiree.com
MAIL_FROM_NAME="Animateur Pour Votre Soirée"
MAIL_REPLY_TO=

# --- Intelligence artificielle (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite

# --- Anti-spam (Cloudflare Turnstile, facultatif)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Publicité et mesure d'audience
ADSENSE_CLIENT=ca-pub-7606734197300781

# --- Cartes et géographie
# Fond de carte : vide = OpenStreetMap (gratuit, sans clé)
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
GEO_API_URL=https://geo.api.gouv.fr

# --- Notifications push (clés VAPID générées automatiquement)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Sécurité
SESSION_LIFETIME_ADMIN=120
ADMIN_2FA_REQUIRED=false
ADMIN_IP_ALLOWLIST=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=10

# --- Performances
PAGE_CACHE=true
PAGE_CACHE_TTL=1800
