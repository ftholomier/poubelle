# Animateur Pour Votre Soirée — contrôleur frontal (Apache)
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Fichiers cachés (.env, .git…) : jamais servis
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    # Fichiers générés par le site : jamais un vieux fichier resté sur le serveur (robots.txt de l'ancien site…)
    RewriteRule ^(robots\.txt|sitemap\.xml|ads\.txt|manifest\.webmanifest|sw\.js)$ index.php [L]
    # Les fichiers réels (assets, médias) sont servis directement
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    # Tout le reste passe par index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|svg|png|jpe?g|webp|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
