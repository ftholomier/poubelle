# Les auditeurs et les scripts de maintenance. Dans l'implantation « à plat »,
# où la racine du dépôt est la racine web, un fichier .php de ce dossier
# serait EXÉCUTÉ par le serveur : schema.php lit tout le contenu, file.php
# manipule la file de publication. Les .py, eux, seraient servis en clair.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Deny from all
</IfModule>
