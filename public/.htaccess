# Sochaux Rétro — Apache (o2switch)
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS et domaine principal (décommenter en production si besoin)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Images déjà générées : servies directement par Apache.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Tout le reste passe par le routeur PHP.
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # HTTPS strict (une fois le site servi en HTTPS ; sans effet en HTTP)
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
    # Fichiers à adresse versionnée (?v=…) : gardés un an par le navigateur, sans revalidation.
    <FilesMatch "\.(woff2|webp|avif|jpg|jpeg|png|gif|svg|css|js|ico|mp3|wav)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Fond de carte (fichier fixe, sans version) : un mois.
    <FilesMatch "\.topojson$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType audio/wav "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/avif .avif
AddType application/json .topojson

# Fichiers sensibles jamais servis
<FilesMatch "^\.|\.(json|php\.bak|log|lock|md)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
