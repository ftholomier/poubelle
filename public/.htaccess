# ---------------------------------------------------------------------
# Le Comptable à Lunettes — configuration Apache de la racine publique
# ---------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forcer HTTPS (décommenter en production derrière un certificat)
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Retirer le www (décommenter selon le domaine canonique choisi)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Les fichiers et dossiers réels sont servis directement…
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # …tout le reste passe par le contrôleur frontal.
    RewriteRule ^ index.php [L]
</IfModule>

# --------------------------------------------------------------- Sécurité
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# Interdire l'accès aux fichiers sensibles
<FilesMatch "^(\.env|\.git|composer\.(json|lock)|.*\.(json|md|log|ini|bak|sql|yml|yaml))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Aucune exécution de script dans les dossiers de téléversement
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
AddType text/plain .php.txt

# ------------------------------------------------------------- Performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

ErrorDocument 404 /index.php
