# Toutes les requêtes qui ne correspondent pas à un fichier existant
# sont confiées au contrôleur frontal.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Le listing de répertoire n'apporte rien et expose l'arborescence.
Options -Indexes

# Un navigateur REFUSE d'exécuter un module ES servi avec un autre type MIME
# qu'un type JavaScript — et il le refuse en silence côté serveur. Sur un
# hébergement dont la table MIME est incomplète, tout le site paraît figé.
# On force donc le type, ainsi que celui des polices et du JSON.
<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Les fichiers statiques portent une empreinte dans leur URL : ils peuvent
# être conservés longtemps par le navigateur.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
    ExpiresByType image/svg+xml           "access plus 30 days"
    # Les fichiers de police ne changent jamais : ils peuvent rester très longtemps.
    ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    # Le woff2 est déjà compressé : le repasser à la moulinette ne gagne rien.
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
