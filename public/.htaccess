# Mairie d’Angeot — configuration Apache du répertoire public.
# La racine web (DocumentRoot) doit pointer sur /public : /app, /config,
# /data et /views restent alors hors d'atteinte depuis le navigateur.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forcer HTTPS (désactiver en local si besoin)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Supprimer le slash final (hors racine)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    # Tout ce qui n'est pas un fichier existant part vers le contrôleur frontal
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]

    # Derrière un répartiteur de charge, mod_ssl ne voit pas le HTTPS et ne
    # pose donc pas la variable qui conditionne HSTS plus bas. On la reprend
    # de l'en-tête que le répartiteur ajoute, faute de quoi l'en-tête ne
    # partirait jamais sur un mutualisé — c'est-à-dire là où il sert.
    RewriteCond %{HTTP:X-Forwarded-Proto} =https
    RewriteRule ^ - [E=HTTPS_DERRIERE_PROXY:1]
</IfModule>

# Interdire l'accès direct aux fichiers de données ou de configuration
<FilesMatch "\.(json|md|yml|yaml|ini|log|sql|lock)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # HSTS — et seulement quand la requête est DÉJÀ en HTTPS. Posé sur une
    # réponse en clair, l'en-tête est ignoré par la norme, mais il condamne
    # aussi le site en développement local si la condition est oubliée. La
    # redirection 301 plus haut protège la deuxième visite ; celui-ci protège
    # la première, qui est la seule interceptable.
    #
    # Ni includeSubDomains ni preload : une mairie héberge souvent un
    # sous-domaine qu'elle ne maîtrise pas (webmail, extranet d'un
    # prestataire), et preload est irréversible pendant des mois.
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS_DERRIERE_PROXY

    # Les assets portent ?v= : leur contenu ne change jamais sous la même
    # adresse. « immutable » dit au navigateur de ne pas même revalider,
    # ce qu'Expires seul ne dit pas.
    <FilesMatch "\.(css|js|woff2?|svg|jpe?g|png|webp|avif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # La négociation d'encodage doit apparaître dans la clé de cache des
    # intermédiaires, sans quoi un proxy sert du gzip à qui n'en veut pas.
    Header append Vary Accept-Encoding

    # Le back-office et l'API ne sont jamais mis en cache : voir
    # App\Core\Entetes, qui pose Cache-Control: no-store depuis PHP. C'est
    # PHP qui s'en charge, parce que ces adresses n'ont pas d'extension et ne
    # se reconnaissent pas par un FilesMatch.
</IfModule>

# Cache long sur les assets versionnés par ?v=
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
    ExpiresByType image/webp            "access plus 1 year"
    ExpiresByType image/avif            "access plus 1 year"
    ExpiresByType image/jpeg            "access plus 1 year"
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType font/woff2            "access plus 1 year"
    ExpiresByType font/woff             "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain
</IfModule>

Options -Indexes
DirectoryIndex index.php
