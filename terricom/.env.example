# ─── Application ───────────────────────────────────────────────
# URL publique de la plateforme (site de la marque)
APP_URL=http://localhost:3000
# Domaine racine : les portails sont servis sur <territoire>.<PLATFORM_DOMAIN>
PLATFORM_DOMAIN=terricom.fr
# Hôtes supplémentaires servant la plateforme (dev, préproduction), séparés par des virgules
PLATFORM_HOSTS=localhost:3000,127.0.0.1:3000
NODE_ENV=development
# Affiche la barre de démonstration et les comptes de démo
DEMO_MODE=true
# Appels sortants (connecteurs, agendas externes) vers des adresses internes : développement uniquement (protection SSRF)
OUTBOUND_ALLOW_PRIVATE=false

# ─── Base de données PostgreSQL ────────────────────────────────
DATABASE_URL=postgres://terricom:terricom@localhost:5432/terricom
DATABASE_POOL_MAX=10

# ─── Sécurité ──────────────────────────────────────────────────
# 32 octets en base64 : openssl rand -base64 32
SESSION_SECRET=change-me-please-change-me-please-32b
# Clé de chiffrement des données sensibles (secrets MFA…) : openssl rand -base64 32
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Sel de hachage des visiteurs anonymes (statistiques sans cookie)
ANALYTICS_SALT=change-me-analytics-salt

# ─── Stockage des médias ───────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=fr-par
S3_BUCKET=terricom-medias
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ─── Emails ────────────────────────────────────────────────────
# smtp | outbox (les emails sont conservés en base et consultables dans la console)
MAIL_DRIVER=outbox
SMTP_URL=smtp://localhost:1025
MAIL_FROM="terricom <bonjour@terricom.fr>"
# Boîte de l'équipe support (notification des nouveaux tickets)
SUPPORT_EMAIL=support@terricom.fr
# Boîte de l'équipe commerciale (demandes de démonstration du site)
SALES_EMAIL=bonjour@terricom.fr

# ─── Intelligence artificielle (Claude) ────────────────────────
# Sans clé, les assistants fonctionnent en mode règles (repli déterministe)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Estimation des coûts dans la console (€ par million de jetons en entrée / sortie)
AI_COST_INPUT_PER_MTOK=5
AI_COST_OUTPUT_PER_MTOK=25
# Coûts d'exploitation estimés affichés dans la console (€) : pour 1 000 emails, par Go stocké et par mois, infrastructure mensuelle
COST_EMAIL_PER_THOUSAND=0.9
COST_STORAGE_PER_GB_MONTH=0.025
COST_INFRA_MONTHLY=650

# ─── Cartographie ──────────────────────────────────────────────
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="© OpenStreetMap contributors"

# ─── Services publics de données ───────────────────────────────
SIRENE_API_URL=https://recherche-entreprises.api.gouv.fr
GEO_API_URL=https://geo.api.gouv.fr
BAN_API_URL=https://api-adresse.data.gouv.fr

# ─── Exploitant (mentions légales des factures) ────────────────
COMPANY_LEGAL_NAME=terricom
COMPANY_ADDRESS=
COMPANY_SIREN=
COMPANY_VAT_NUMBER=
COMPANY_IBAN=
# Mentions légales du site de la marque
PUBLICATION_DIRECTOR=
HOSTING_PROVIDER="Nom de l'hébergeur, adresse, téléphone (infrastructure en France)"
DPO_EMAIL=dpo@terricom.fr

# ─── Paiement (optionnel, abonnements Premium par carte) ───────
# Jeton des métriques Prometheus (GET /api/metrics avec Authorization: Bearer <jeton>)
METRICS_TOKEN=

# Passerelle SMS (facultative) : POST JSON { to, text } avec l'en-tête Authorization: Bearer <token>.
# Sans passerelle, les codes de revendication sont envoyés par courrier (imprimé depuis le back-office).
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications push (Web Push) : générer avec `npx web-push generate-vapid-keys` ; vides = notifications désactivées
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@terricom.fr
