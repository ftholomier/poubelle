{
  "name": "terricom",
  "version": "1.0.0",
  "private": true,
  "description": "terricom — la plateforme d'animation et de valorisation économique du territoire",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
