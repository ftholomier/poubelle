    "db:reset": "tsx scripts/reset.ts && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
