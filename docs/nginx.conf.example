# Exemple de configuration nginx.
# La racine web pointe sur public/ : rien d'autre n'est exposé.

# Un navigateur refuse d'exécuter un module ES servi avec un autre type MIME
# qu'un type JavaScript. Vérifiez que /etc/nginx/mime.types est bien inclus :
# sans lui, tout est servi en application/octet-stream et le site paraît figé.
include       mime.types;
types {
    text/javascript js mjs;
}
default_type  application/octet-stream;

server {
    listen 80;
    server_name exemple.fr;
    root /var/www/particules/public;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    # Les URL des fichiers statiques portent une empreinte (?v=…) :
    # une longue durée de conservation est sans risque.
    location ~* \.(css|js|svg|png|jpg|webp)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # Les polices ne changent jamais : conservation longue, et en-tête CORS
    # requis par la balise <link rel="preload" as="font" crossorigin>.
    location ~* \.woff2$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Access-Control-Allow-Origin "*";
        try_files $uri =404;
    }

    # Rien à servir en dehors de public/.
    location ~ /\.(?!well-known) { deny all; }
}
