storage/cache/*
!storage/cache/.gitkeep
storage/sauvegardes/
data/admin/
.DS_Store
*.tmp
storage/deploiements/
data/assistant/documents/*
!data/assistant/documents/.gitkeep
data/assistant/notes.html
paquet-maj/

# le contenu vivant appartient au serveur ; le depot ne porte que data-modele/
data/*.json
data/pages/

# reseaux sociaux : file d'attente, journal des envois, vignettes generees
data/reseaux/
# frequentation : pages vues par jour, ecrites par le site lui-meme
data/conseiller/
data/frequentation/
public/assets/img/reseaux/*
!public/assets/img/reseaux/.gitkeep

# cache de Python : mise-en-page.py importe l'inventaire d'ecrans d'alertes.py,
# ce qui fait apparaitre un __pycache__ a cote des auditeurs
outils/verifs/__pycache__/
