# Si la racine web du serveur pointe sur ce dossier au lieu de /public,
# tout est redirigé vers /public sans exposer app/ ni data/.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "\.(json|md|log|env|lock)$">
        Require all denied
    </FilesMatch>
</IfModule>

Options -Indexes
