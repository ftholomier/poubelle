# =============================================================================
# Le iOiO — configuration serveur.
# Copiez ce fichier en « .env » à la racine du projet (hors racine web).
# Toute clé renseignée ici est PRIORITAIRE sur celles saisies au back-office
# et apparaît en lecture seule dans Réglages → Clés API.
# =============================================================================

# URL publique du site, sans slash final. Utilisée pour les emails, le sitemap
# et les données structurées. Déduite de la requête si absente.
SITE_URL="https://www.ioio.fr"

# Préfixe d'URL si le site n'est pas à la racine du domaine (rare).
# BASE_PATH=""

APP_TIMEZONE="Europe/Paris"
APP_DEBUG=false

# --- Assistant IA (Gemini) ---------------------------------------------------
# Sans clé, l'assistant répond à partir de l'index local et des réponses
# rapides du back-office : le site reste fonctionnel.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Avis Google (Places API) ------------------------------------------------
# Sans clé, le site affiche les avis saisis dans content/reviews.json.
GOOGLE_PLACES_KEY=""
GOOGLE_PLACE_ID=""

# --- Traduction assistée (Google Cloud Translation) --------------------------
GOOGLE_TRANSLATE_KEY=""

# --- Emails ------------------------------------------------------------------
MAIL_FROM="no-reply@ioio.fr"
MAIL_FROM_NAME="Le iOiO"
# Boîte qui reçoit les demandes du site. Par défaut : l'email de contact des réglages.
MAIL_TO=""

# SMTP facultatif : laissez SMTP_HOST vide pour utiliser mail() de l'hébergeur.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="tls"
SMTP_USER=""
SMTP_PASS=""

# --- Divers ------------------------------------------------------------------
# IP du reverse proxy de confiance, si le site est derrière un proxy.
# TRUSTED_PROXY="127.0.0.1"
