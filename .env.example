# ---------------------------------------------------------------------
# Configuration du site — copier ce fichier en « .env » et le compléter.
# Le fichier .env n'est jamais versionné et n'est jamais accessible en HTTP.
# ---------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.lecomptablealunettes.fr
APP_TIMEZONE=Europe/Paris

# Chaîne aléatoire de 64 caractères : openssl rand -hex 32
APP_KEY=

# Redirection HTTPS forcée (à activer une fois le certificat en place)
FORCE_HTTPS=true

# Adresses IP des reverse-proxies de confiance, séparées par des virgules.
# Nécessaire seulement si le site est derrière un load-balancer ou un CDN.
TRUSTED_PROXIES=

# --------------------------------------------------------------- E-mails
# mail   : fonction mail() de PHP (par défaut chez la plupart des hébergeurs)
# smtp   : serveur SMTP (recommandé, meilleure délivrabilité)
# log    : aucun envoi, les messages sont écrits dans storage/logs/mail.log
MAIL_TRANSPORT=mail
MAIL_FROM=no-reply@lecomptablealunettes.fr
MAIL_FROM_NAME="Le comptable à lunettes"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

# ------------------------------------------------------- Assistant Gemini
# Clé obtenue sur https://aistudio.google.com/apikey
# Sans clé, l'assistant fonctionne quand même : il cite le meilleur extrait
# trouvé dans les pages et documents du site.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ----------------------------------------------------------- Avis Google
# Clé « Places API (New) » et identifiant de fiche établissement.
# Sans clé, ce sont les avis saisis dans le back-office qui s'affichent.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
